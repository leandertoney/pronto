# Copy this file to .env and fill in your own keys.
# ⚠️ These are EXPO_PUBLIC_* vars: they are bundled into the client app.
# Personal testing only — never ship these keys in a public build.

# OpenAI — used for Whisper speech-to-text (whisper-1)
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Anthropic — used for the Claude conversation engine (claude-sonnet-4-6)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
