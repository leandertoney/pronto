{
  "expo": {
    "name": "Qué Onda",
    "slug": "que-onda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "queonda",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7EC",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Qué Onda listens to you speak so it can teach you Spanish phrases for what you're doing right now."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Qué Onda listens to you speak so it can teach you Spanish phrases for what you're doing right now."
        }
      ],
      "expo-asset"
    ]
  }
}
